# Block search engines from indexing the temporary *.pages.dev URLs.
# These rules are HOST-SCOPED: they apply ONLY to the pages.dev hostnames,
# never to the real custom domain. When lovepathways.org is connected it
# indexes normally and nothing here needs to be changed or removed.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# Security headers for the production hostnames only, so the pages.dev
# hostnames above keep just their noindex rule.
#
# HSTS is 15552000 (6 months). It shipped at max-age=300 first and was confirmed
# live on both hostnames before being raised, because browsers cache the policy
# and a long max-age cannot be walked back if something later needs plain HTTP.
# Lower it back to 300 and wait 5 minutes before any change that might.
#
# includeSubDomains is deliberately absent. Cloudflare flags
# enterpriseenrollment.lovepathways.org and _domainconnect.* as lacking valid
# TLS, and including subdomains would make browsers refuse them with no quick
# way back. The apex and www are the only hostnames people browse.
#
# No Content-Security-Policy here: the site loads GTM, Google Fonts and GHL
# embeds, and a CSP written without inventorying every one of those breaks the
# page silently. Worth doing as its own task, not as a side effect of this one.
https://lovepathways.org/*
  Strict-Transport-Security: max-age=15552000
  X-Frame-Options: SAMEORIGIN

https://www.lovepathways.org/*
  Strict-Transport-Security: max-age=15552000
  X-Frame-Options: SAMEORIGIN
